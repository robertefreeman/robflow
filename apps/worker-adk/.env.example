DATABASE_URL=postgresql://robflow:robflow_dev_password@localhost:5432/robflow
WORKER_ADK_HOST=127.0.0.1
WORKER_ADK_PORT=8080


# Optional OpenAI-compatible inference contract for local worker runs.
# Production workers should prefer the web app's persisted config when database access is available.
ROBFLOW_INFERENCE_BASE_URL=https://api.openai.com/v1
ROBFLOW_INFERENCE_API_KEY=
ROBFLOW_INFERENCE_DEFAULT_MODEL=gpt-4o-mini
ROBFLOW_INFERENCE_HEADERS_JSON={}
ROBFLOW_INFERENCE_TIMEOUT_SECONDS=30
ROBFLOW_INFERENCE_MAX_RETRIES=2
WORKER_ADK_POLL_INTERVAL_SECONDS=2
WORKER_ADK_LEASE_SECONDS=60
WORKER_ADK_RUN_ONCE=false
