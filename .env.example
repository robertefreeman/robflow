POSTGRES_USER=robflow
POSTGRES_PASSWORD=robflow_dev_password
POSTGRES_DB=robflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://robflow:robflow_dev_password@postgres:5432/robflow
WEB_PORT=3000
WORKER_ADK_PORT=8080
# Host CLI default for Drizzle migration/seed commands.
LOCAL_DATABASE_URL=postgresql://robflow:robflow_dev_password@localhost:5432/robflow

# 32-byte key for encrypting persisted inference API keys. Generate with: openssl rand -base64 32
INFERENCE_CONFIG_ENCRYPTION_KEY=
